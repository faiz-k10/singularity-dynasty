# Copy this file to .env.local and fill in your own Stripe test-mode keys
# from https://dashboard.stripe.com/test/apikeys
# Never commit .env.local — it's gitignored.

STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Created by `node --env-file=.env.local scripts/create-stripe-products.mjs`
STRIPE_PRICE_EXPLORER_MONTHLY=price_...
STRIPE_PRICE_EXPLORER_ANNUAL=price_...
STRIPE_PRICE_SINGULARITY_MONTHLY=price_...
STRIPE_PRICE_SINGULARITY_ANNUAL=price_...

# Filled in once the webhook is registered (see `stripe listen` output locally,
# or the Stripe Dashboard webhook endpoint for production)
STRIPE_WEBHOOK_SECRET=whsec_...

# From your Supabase project's Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
