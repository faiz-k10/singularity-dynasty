{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web"
      ],
      "port": 3000
    },
    {
      "name": "mockups",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd web && npx next build && npx next start -p 3100"
      ],
      "port": 3100
    }
  ]
}